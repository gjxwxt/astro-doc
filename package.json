{
  "name": "josh-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc -p packages/mcp-server/tsconfig.json --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:notes": "tsx scripts/sync-content.ts",
    "sync:library": "tsx scripts/sync-obsidian.ts",
    "sync:notes:watch": "tsx scripts/sync-content.ts --watch",
    "new:note": "tsx scripts/new-note.ts",
    "mcp": "pnpm --filter @portal/mcp-server start",
    "mcp:dev": "pnpm --filter @portal/mcp-server dev",
    "mcp:build": "pnpm --filter @portal/mcp-server build",
    "build:all": "pnpm build && pnpm mcp:build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.7",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.4.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
