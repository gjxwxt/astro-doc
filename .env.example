# 站点公开地址（用于 canonical、sitemap、RSS、MCP）
SITE_URL=https://example.com

# AI 助手：任何 OpenAI 兼容的 /chat/completions 服务
# 不配置 AI_API_KEY / GEMINI_API_KEY 时，助手会自动降级为“站内检索”模式，不会报错。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Gemini 可以只填这一把 key，公开助手会回退读取它（与 AI_API_KEY 二选一）。
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini
# 可选：OpenAI 的 reasoning_effort，或 Gemini 兼容层的 low / medium / high。
# 用 Gemini 时：AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            GEMINI_API_KEY=<key>
#            AI_MODEL=gemini-3.8-flash
#            AI_REASONING_EFFORT=low
AI_REASONING_EFFORT=

# Phase 2 私有工作台（本地开发也要设；生产必须改成强密码/随机 secret）
ADMIN_PASSWORD=
SESSION_SECRET=
PRIVATE_API_TOKEN=
PORTAL_DATA_DIR=./data
# 图片/媒体存储：local 存 PORTAL_DATA_DIR/media；后续可扩展 s3
MEDIA_DRIVER=local
# 对外可访问的绝对地址；留空时上传 API 返回相对路径 /media/<hash>.<ext>
# 例：https://portal.example.com 或 http://<server-ip>:4400
MEDIA_PUBLIC_BASE_URL=

# 可选：给 /api/tools/* 和 /api/chat 加一个 Bearer Token。
# 公开部署且担心被刷时设置；MCP 服务端使用同名变量。
PORTAL_API_TOKEN=

# 可选：音乐下载结果凭证的加密密钥。
# 不配置时每次启动随机生成，重启后旧的搜索结果会失效。
MUSIC_TOKEN_SECRET=

# 可选：视频解析服务（抖音/TikTok/B站等）。
# 约定：POST <url>，body { "url": "..." }，返回 { title, videoUrl, images?, author? }。
# 不配置时，媒体工具只做 Open Graph 预览，不会假装能解析。
MEDIA_RESOLVER_URL=
MEDIA_RESOLVER_TOKEN=

# 可选：知乎 / JS 空壳页面的文字 Reader 兜底。
# 只在页面标题为空、标题等于站点名，或页面直接拒绝请求时使用。
# 会把目标 URL 发送到该服务；留空则只用页面元数据，并在失败时显示明确提示。
# Jina Reader 可填 https://r.jina.ai/
LINK_READER_URL=
