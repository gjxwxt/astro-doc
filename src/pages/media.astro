---
import PortalLayout from '@/layouts/PortalLayout.astro';
import { getDatabase } from '@/lib/db/client';
import { listMedia } from '@/lib/db/media';
import { publicMediaUrl } from '@/lib/media';
import { getSession } from '@/lib/private-auth';
import '@/styles/private.css';

export const prerender = false;

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

const session = getSession(Astro.request, process.env);
if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const perPage = 48;
const rawPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isFinite(rawPage) ? Math.max(1, Math.trunc(rawPage)) : 1;
const db = getDatabase();
const result = listMedia(db, session.sub, { limit: perPage, offset: (page - 1) * perPage });
const mediaItems = result.media.map((item) => ({
  ...item,
  displayUrl: publicMediaUrl(item.storageKey),
}));
const totalPages = Math.max(1, Math.ceil(result.total / perPage));

function formatBytes(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function formatDate(value: string): string {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
}
---

<PortalLayout title="媒体库" noindex bare private bodyClass="private-body">
  <header class="private-bar">
    <a class="private-brand" href="/">Josh</a>
    <nav aria-label="私有导航">
      <a href="/inbox">Inbox</a>
      <a href="/drafts">Drafts</a>
      <a href="/media" aria-current="page">媒体</a>
      <a href="/">回到门户</a>
      <button class="fragment-delete" type="button" data-logout>退出</button>
    </nav>
  </header>

  <main class="private-shell media-shell" data-media>
    <header class="private-head media-head">
      <div>
        <p class="private-eyebrow">Private workspace</p>
        <h1>Media</h1>
        <p>已经进入 Josh 的图片都在这里。粘贴、拖入或点开选择，原图会按内容哈希去重保存。</p>
      </div>
      <div class="media-stat" aria-label="媒体统计">
        <strong>{result.total}</strong>
        <span>张 · {formatBytes(result.totalBytes)}</span>
      </div>
    </header>

    <label class="media-drop" data-media-drop tabindex="0">
      <input
        class="media-file"
        type="file"
        accept="image/png,image/jpeg,image/webp,image/gif,image/avif"
        multiple
        data-media-file
      />
      <span class="media-drop-mark" aria-hidden="true">＋</span>
      <span class="media-drop-title">拖入、粘贴或点开选择图片</span>
      <span class="media-drop-hint">PNG / JPEG / WebP / GIF / AVIF · 单张最多 20MB</span>
    </label>
    <p class="media-status" data-media-status role="status" aria-live="polite"></p>

    {
      result.media.length === 0 ? (
        <section class="media-empty">
          <p class="private-eyebrow">Nothing here yet</p>
          <h2>媒体库还是空的</h2>
          <p>从 Chrome 右键保存一张图片，或者直接往上面拖一张试试。</p>
        </section>
      ) : (
        <section class="media-grid" aria-label="媒体文件">
          {mediaItems.map((item) => (
            <article class="media-card">
              <a
                class="media-thumb"
                href={item.displayUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`打开 ${item.originalName || '图片'}`}
              >
                <img
                  src={item.displayUrl}
                  alt={item.originalName || 'Josh 媒体图片'}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="media-card-body">
                <div class="media-card-title">
                  <strong title={item.originalName || item.storageKey}>
                    {item.originalName || item.storageKey}
                  </strong>
                  <span>{formatBytes(item.bytes)}</span>
                </div>
                <p class="media-card-meta">
                  {item.mime} · {formatDate(item.createdAt)}
                </p>
                <div class="media-card-actions">
                  <button
                    class="media-action"
                    type="button"
                    data-copy-url={item.displayUrl}
                  >
                    复制链接
                  </button>
                  <a class="media-action" href={item.displayUrl} target="_blank" rel="noreferrer">
                    原图
                  </a>
                </div>
              </div>
            </article>
          ))}
        </section>
      )
    }

    {
      totalPages > 1 && (
        <nav class="media-pagination" aria-label="媒体分页">
          {page > 1 ? (
            <a class="private-button private-button--small" href={`/media?page=${page - 1}`}>
              上一页
            </a>
          ) : (
            <span />
          )}
          <span>
            {page} / {totalPages}
          </span>
          {page < totalPages ? (
            <a class="private-button private-button--small" href={`/media?page=${page + 1}`}>
              下一页
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </main>
</PortalLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-media]');
  const drop = document.querySelector<HTMLLabelElement>('[data-media-drop]');
  const input = document.querySelector<HTMLInputElement>('[data-media-file]');
  const status = document.querySelector<HTMLElement>('[data-media-status]');
  const MAX_BYTES = 20 * 1024 * 1024;

  function setStatus(message: string, tone = '') {
    if (!status) return;
    status.textContent = message;
    status.dataset.tone = tone;
  }

  async function uploadFiles(files: FileList | File[]) {
    const images = [...files].filter((file) => file.type.startsWith('image/'));
    if (images.length === 0) {
      setStatus('这里只接受图片文件。', 'error');
      return;
    }

    let uploaded = 0;
    let failed = 0;
    for (const file of images) {
      if (file.size > MAX_BYTES) {
        failed += 1;
        setStatus(`${file.name} 超过 20MB，跳过。`, 'error');
        continue;
      }
      setStatus(`正在上传 ${uploaded + failed + 1} / ${images.length}：${file.name}`);
      try {
        const response = await fetch('/api/media/upload', {
          method: 'POST',
          headers: {
            'content-type': file.type || 'application/octet-stream',
            'x-file-name': encodeURIComponent(file.name || 'image'),
          },
          body: await file.arrayBuffer(),
        });
        if (response.status === 401) {
          window.location.assign('/login?next=/media');
          return;
        }
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload?.ok) {
          throw new Error(payload?.error?.message || `上传失败（${response.status}）`);
        }
        uploaded += 1;
      } catch (error) {
        failed += 1;
        setStatus(error instanceof Error ? error.message : String(error), 'error');
      }
    }

    if (uploaded > 0) {
      setStatus(`已上传 ${uploaded} 张${failed ? `，${failed} 张失败` : ''}。`, 'ok');
      window.setTimeout(() => window.location.reload(), 450);
    } else if (failed > 0) {
      setStatus('没有图片上传成功。', 'error');
    }
  }

  input?.addEventListener('change', () => {
    if (!input.files) return;
    void uploadFiles(input.files);
    input.value = '';
  });

  drop?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      input?.click();
    }
  });

  for (const type of ['dragenter', 'dragover']) {
    drop?.addEventListener(type, (event) => {
      event.preventDefault();
      drop.classList.add('is-dragging');
    });
  }
  for (const type of ['dragleave', 'drop']) {
    drop?.addEventListener(type, (event) => {
      event.preventDefault();
      drop.classList.remove('is-dragging');
    });
  }
  drop?.addEventListener('drop', (event) => {
    const files = event.dataTransfer?.files;
    if (files?.length) void uploadFiles(files);
  });

  document.addEventListener('paste', (event) => {
    if (!root) return;
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA)$/.test(target.tagName))) {
      return;
    }
    const files = event.clipboardData?.files;
    if (files?.length) {
      event.preventDefault();
      void uploadFiles(files);
    }
  });

  document.addEventListener('click', async (event) => {
    const button = event.target instanceof Element
      ? event.target.closest('[data-copy-url]')
      : null;
    if (!(button instanceof HTMLButtonElement)) return;
    const url = button.dataset.copyUrl;
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      const previous = button.textContent;
      button.textContent = '已复制';
      window.setTimeout(() => { button.textContent = previous; }, 1200);
    } catch {
      setStatus('复制失败，请打开原图后复制地址。', 'error');
    }
  });
</script>
