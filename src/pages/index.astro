---
import { getCollection } from 'astro:content';

import Rail from '@/components/home/Rail.astro';
import Icon from '@/components/ui/Icon.astro';
import PortalLayout from '@/layouts/PortalLayout.astro';
import { siteConfig } from '@/config/site';
import { faviconFallbackUrl, faviconUrl, formatDate, isoDate } from '@/lib/format';
import { plugins } from '@/plugins/registry';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const docs = (await getCollection('docs', ({ data }) => !data.draft)).filter(
  (entry) => entry.id !== 'docs',
);
const bookmarkGroups = (await getCollection('bookmarks')).sort(
  (a, b) => a.data.order - b.data.order,
);
const allBookmarks = bookmarkGroups.flatMap((group) => group.data.items);

const recent = [
  ...notes.map((entry) => ({
    type: '笔记',
    title: entry.data.title,
    description: entry.data.description ?? '',
    url: `/notes/${entry.id}/`,
    date: entry.data.date,
  })),
  ...docs
    .filter((entry) => entry.data.date)
    .map((entry) => ({
      type: '文档',
      title: entry.data.title,
      description: entry.data.description ?? '',
      url: `/${entry.id}/`,
      date: entry.data.date as Date,
    })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6);

const featuredBookmarks = [
  ...allBookmarks.filter((item) => item.featured),
  ...allBookmarks.filter((item) => !item.featured),
].slice(0, 12);

const featuredPlugin = plugins.find((plugin) => plugin.id === 'music') ?? plugins[0];
const otherPlugins = plugins.filter((plugin) => plugin.id !== featuredPlugin?.id);

const statusLabel: Record<string, string> = {
  stable: '可用',
  beta: '测试中',
  experimental: '实验',
  'needs-config': '需配置',
};

const latestNote = notes[0];
---

<PortalLayout bare bodyClass="is-home">
  <div class="home-grid">
    <Rail />

    <div class="home-main">
      <div class="home-inner">
        <div class="stats" data-reveal-group>
          <div class="stat" data-reveal>
            <strong>{docs.length + 1}</strong>
            <span>篇文档</span>
          </div>
          <div class="stat" data-reveal>
            <strong>{notes.length}</strong>
            <span>篇笔记</span>
          </div>
          <div class="stat" data-reveal>
            <strong>{plugins.length}</strong>
            <span>个工具</span>
          </div>
          <div class="stat" data-reveal>
            <strong>{allBookmarks.length}</strong>
            <span>个收藏</span>
          </div>
        </div>

        <section class="home-section" aria-labelledby="recent-title">
          <div class="section-head">
            <div>
              <h2 id="recent-title">最近</h2>
              <p>文档和笔记的最新改动。日期来自内容本身，不是访问时间。</p>
            </div>
            <a class="text-link" href="/notes/">全部笔记 <Icon name="arrow-up-right" size={14} /></a>
          </div>

          <div class="recent-list" data-reveal-group>
            {
              recent.map((item) => (
                <a class="recent-item" href={item.url} data-reveal>
                  <span class="recent-date">{formatDate(item.date)}</span>
                  <span class="recent-type">{item.type}</span>
                  <span>
                    <span class="recent-title">{item.title}</span>
                    {item.description && <span class="recent-desc">{item.description}</span>}
                  </span>
                  <span class="recent-arrow" aria-hidden="true">
                    <Icon name="arrow-up-right" size={16} />
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="home-section" aria-labelledby="tools-title">
          <div class="section-head">
            <div>
              <h2 id="tools-title">工具</h2>
              <p>能直接用的东西。每个工具是一个插件，页面、API 和 MCP 共用一份定义。</p>
            </div>
            <a class="text-link" href="/tools/">全部工具 <Icon name="arrow-up-right" size={14} /></a>
          </div>

          {
            featuredPlugin && (
              <article class="tool-feature" data-reveal>
                <div>
                  <span class="tool-glyph">
                    <Icon name={featuredPlugin.icon} size={22} />
                  </span>
                  <h3>{featuredPlugin.name}</h3>
                  <p>{featuredPlugin.description}</p>
                  <a class="button" href={`/tools/${featuredPlugin.id}/`}>
                    打开工具 <Icon name="arrow-right" size={15} />
                  </a>
                </div>
                <div class="tool-snippet" aria-label="接口示例">
                  <pre><code>{`POST /api/tools/music/search

{
  "query": "晴天 周杰伦",
  "limit": 4
}`}</code></pre>
                </div>
              </article>
            )
          }

          <div class="tool-rows" data-reveal-group>
            {
              otherPlugins.map((plugin) => (
                <a class="tool-row" href={`/tools/${plugin.id}/`} data-reveal>
                  <span class="tool-row-icon">
                    <Icon name={plugin.icon} size={18} />
                  </span>
                  <span>
                    <h3>{plugin.name}</h3>
                    <p>{plugin.tagline}</p>
                  </span>
                  <span class="tool-row-meta">
                    <span class={`status status--${plugin.status}`}>{statusLabel[plugin.status]}</span>
                    <Icon name="arrow-up-right" size={15} />
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <section class="band" aria-labelledby="bookmarks-title" data-reveal>
          <div class="band-inner">
            <div class="section-head">
              <div>
                <h2 id="bookmarks-title">收藏</h2>
                <p>{bookmarkGroups.length} 个分类 · {allBookmarks.length} 个链接，常用的入口都在这里。</p>
              </div>
              <a class="text-link" href="/bookmarks/">打开收藏夹 <Icon name="arrow-up-right" size={14} /></a>
            </div>

            <div class="bookmark-preview">
              {
                featuredBookmarks.map((item) => (
                  <a
                    class="bookmark-preview-item"
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="bookmark-favicon">
                      <span class="bookmark-fallback" aria-hidden="true">
                        {item.name.slice(0, 1)}
                      </span>
                      <img
                        src={faviconUrl(item.url)}
                        alt=""
                        width="24"
                        height="24"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        data-favicon
                        data-favicon-fallback={faviconFallbackUrl(item.url)}
                      />
                    </span>
                    <span>{item.name}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </section>

        <section class="home-section" aria-labelledby="about-title">
          <div class="section-head">
            <div>
              <h2 id="about-title">关于</h2>
              <p>这个站为什么长这样，以及它现在用来做什么。</p>
            </div>
            <a class="text-link" href="/about/">更多 <Icon name="arrow-up-right" size={14} /></a>
          </div>

          <div class="letter" data-reveal>
            <p>这个站最早是一个 Starlight 文档模板，后来加了一个硬编码的网址导航。文档、导航和样式混在一起，改起来越来越费劲。</p>
            <p>现在把它们拆开了：文档、笔记、工具和收藏各归其位，样式和搜索共用一套，更新起来更省事。</p>
            <p>这里不是产品，是一个长期维护的个人工作台。东西会慢慢加，架构先留好位置。</p>
            <p class="signature">{siteConfig.name}</p>
          </div>
        </section>

        <footer class="home-footer">
          <span>© {new Date().getFullYear()} {siteConfig.name}</span>
          <nav aria-label="页脚导航">
            <a href="/docs/">文档</a>
            <a href="/notes/">笔记</a>
            <a href="/tools/">工具</a>
            <a href="/bookmarks/">收藏</a>
            <a href="/notes/rss.xml">RSS</a>
            <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </nav>
          <span>{latestNote ? `最近笔记 ${isoDate(latestNote.data.date)}` : 'Astro 7 + Starlight'}</span>
        </footer>
      </div>
    </div>
  </div>
</PortalLayout>
