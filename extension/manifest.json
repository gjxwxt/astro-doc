{
  "manifest_version": 3,
  "name": "Josh Inbox",
  "version": "0.5.0",
  "description": "把当前网页的选中文字、链接、图片或同页多段标注保存到私有 Josh Inbox。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:4400/*",
    "http://127.0.0.1:4400/*",
    "https://docs.gaojiaxiang.cn/*",
    "https://media.gaojiaxiang.cn/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "保存到 Josh Inbox",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
